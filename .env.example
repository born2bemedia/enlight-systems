# Email — SendGrid (recommended)
# https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=your-sendgrid-api-key
MAIL_FROM=noreply@enlight.systems
MAIL_TO=info@enlight.business

# Manual article newsletter: POST /api/send-emails?secret=...
ADMIN_NOTIFY_SECRET=your-long-random-secret
NOTIFY_API_URL=https://enlight.systems

# Legacy Gmail SMTP (optional fallback)
SMTP_USER=noreply@enlight.systems
SMTP_PASS=your-gmail-app-password

# Scamadviser Trust API — https://api.scamadviser.cloud/docs/
SCAMADVISER_API_KEY=your-scamadviser-api-key

# Upstash Redis — article views + subscriber emails (Vercel Production)
UPSTASH_REDIS_REST_URL=your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Website-analysis Python backend (trust-check + site-report).
# Client-side fetch — must keep the NEXT_PUBLIC_ prefix to reach the browser.
NEXT_PUBLIC_API_BASE_URL=https://enlight-webaudit-api-production.up.railway.app
